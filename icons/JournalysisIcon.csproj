<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Package.customization</AssemblyName>
    <RootNamespace>JournalysisIcon</RootNamespace>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="raw\**" />
    <EmbeddedResource Remove="raw\**" />
    <None Remove="raw\**" />
    <None Remove="Credits.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="PackageImages.resx">
      <LogicalName>PackageImages.resources</LogicalName>
      <ManifestResourceName>PackageImages</ManifestResourceName>
      <Generator />
    </EmbeddedResource>
  </ItemGroup>

</Project>